{
	"compilerOptions": {
		"jsx": "react-jsx",
		"jsxImportSource": "../utils",
		"module": "Node16",
		"moduleResolution": "Node",
		"target": "ES2022",
		"checkJs": true,  /* Typecheck .js files. */
		"lib": [
			"ES2022"
		],
		"allowJs": true,
		"allowImportingTsExtensions": true
	},
	"exclude": [
		"node_modules"
	]
}
